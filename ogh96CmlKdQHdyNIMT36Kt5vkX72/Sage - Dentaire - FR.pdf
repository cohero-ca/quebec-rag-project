   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Confident young man looking away with big smile. Happy handsome guy looking through window thinking about the future. Closeup face of smiling casual man imagine with copy space.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>looking away,daydream,happy,contemplating,determination,smile,wh</rdf:li>
    </rdf:Bag>
   </dc:subject>
